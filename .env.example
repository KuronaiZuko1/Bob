# =====================================
# BOB - ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================

APP_NAME=Bob
APP_ENV=development
DEBUG=true

# DATABASE
DATABASE_URL=sqlite:///./bob.db

# TELEGRAM BOT
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_here

# AI CONFIGURATION
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Optional AI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# GMAIL CONFIGURATION
EMAIL_PROVIDER=gmail
GMAIL_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_client_secret
GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback
GMAIL_CREDENTIALS_FILE=credentials/gmail-oauth.json

# SECURITY
ENCRYPTION_KEY=generate_64_char_hex_key
SECRET_KEY=generate_64_char_hex_key

# JOB SEARCH
JOB_SEARCH_INTERVAL_HOURS=6
JOB_MARKET=South Africa
AUTO_APPLY_ENABLED=false
TEST_MODE=true

# DOCUMENT STORAGE
DOCUMENT_STORAGE_PATH=./secure_documents
MAX_UPLOAD_MB=15

# LOGGING
LOG_LEVEL=INFO
